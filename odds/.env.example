# ---------------------------------------------------------------------------
# sure_tips / odds - example environment file.
# Copy to odds/.env and fill in real values. NEVER commit odds/.env.
#   PowerShell:  Copy-Item odds\.env.example odds\.env
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Required, no default. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-generated-secret-key

# Optional. Defaults to False. Set to True for local development only.
# Missing values use the configured safe default (False). Invalid boolean values
# are configuration errors and must be corrected before Django can start.
DEBUG=False

# Optional. Comma-separated. Defaults to local hosts only (no wildcard):
#   localhost,127.0.0.1,[::1]
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- CORS ------------------------------------------------------------------
# Optional. Defaults to False. Local development only - never enable in a
# deployed environment (it allows every browser origin to read the API).
CORS_ALLOW_ALL_ORIGINS=False

# Optional. Ignored while CORS_ALLOW_ALL_ORIGINS is True. Comma-separated list
# of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Transport security ------------------------------------------------------
# Optional, explicit and independent: settings.py reads each of these on its own
# and derives none of them from DEBUG, so the safe values below are exactly what
# an unset environment gets - plain HTTP keeps working locally.
#
# A deployment sets all six (fly.toml [env]) to switch HTTPS redirect, secure
# cookies and HSTS on. They carry no credential, so they are not secrets; see
# docs/DEPLOYMENT.md section 3.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Seconds of HSTS. 0 sends no Strict-Transport-Security header at all; the usual
# deployment value is 31536000 (one year).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Database ---------------------------------------------------------------
# Optional. Unset (the default) means the local, git-ignored SQLite file
# odds/db.sqlite3, which is what local development and the test suite use.
#
# A deployed service sets DATABASE_URL instead - Fly Postgres attaches one
# automatically - and that URL always wins over the SQLite default. The value
# carries the database password, so it is a SECRET: never commit it, never bake
# it into an image, and never log it.
#
# PostgreSQL is configured pooling-safe in odds/odds/settings.py (no connection
# reuse, no server-side cursors, no prepared statements). Nothing in this file
# changes that, and the SQLite default has none of it applied.
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Email -----------------------------------------------------------------
# Required, no default.
DEFAULT_FROM_EMAIL=no-reply@example.com

# Optional (defaults shown).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Scraper ---------------------------------------------------------------
# Required, no default. Base URL of the upstream tips site, no trailing slash.
SCRAPE_URL=https://www.freesupertips.com

# Optional. Defaults to False. Result/settlement verification is NOT implemented
# yet; keep disabled until a real results source exists. Missing values use the
# configured safe default (False); an invalid boolean value is a configuration
# error and must be corrected before Django can start.
FREESUPERTIPS_ENABLE_VERIFICATION=False

# --- Logging ---------------------------------------------------------------
# Optional. Defaults shown. Never place secrets in log output.
DJANGO_LOG_LEVEL=INFO
ALLTIPS_LOG_LEVEL=INFO
